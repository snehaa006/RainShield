# Copy to .env.local (gitignored) for local overrides.

# Inference API base URL. Leave empty to call the same origin — in dev that is
# the Vite proxy, which forwards /api and /health to a backend on port 8000.
# Production builds fall back to .env.production, which points at Render.
VITE_API_BASE=

# CARTO basemap key. Optional — the public raster tiles also serve without one,
# but they carry an "API KEY REQUIRED" watermark. Free up to 5M tiles/month:
# https://carto.com/basemaps/apikey
# Vite inlines VITE_* into the client bundle, so restrict this key by HTTP
# referrer rather than treating it as a secret.
VITE_BASEMAP_KEY=
