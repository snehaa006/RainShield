# Build-time defaults for production bundles (Vercel picks this up automatically).
#
# VITE_* values are inlined into the client bundle, so nothing here is secret —
# the API base is visible in the browser's network tab either way. Committing it
# keeps the deployment reproducible from the repo instead of depending on a
# dashboard setting. A VITE_API_BASE set in Vercel's project settings still wins
# over this file, so overriding it per-environment works as usual.
VITE_API_BASE=https://rainshield-api.onrender.com
